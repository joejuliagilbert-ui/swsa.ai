# Node / Eleventy build system (C1 technical foundation)
node_modules/
_site/

# Build-time generated assets (regenerated by `npm run prebuild`)
src/assets/fonts/*.woff2
src/assets/img-src/generated-*.jpg

# Generated test fixtures (regenerated by `npm run fixtures`)
test/fixtures/

# Negative-build test output
test/_neg/**/_site/

# Protected intake staging guard (D1A) — keep unselected intake assets out of
# staging. The two selected public assets are already tracked and are explicitly
# re-included so they are never ignored.
docs/brand-assets/
src/assets/people/
src/assets/brand/components/*
!src/assets/brand/components/swsa-ai-navy.png
src/assets/partners/*
!src/assets/partners/secure24-adt-authorized-dealer-blue.svg

# OS / editor noise
.DS_Store
