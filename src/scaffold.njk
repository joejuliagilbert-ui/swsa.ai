---
layout: layouts/base.njk
pagination:
  data: routes
  size: 1
  alias: route
  addAllPagesToCollections: true
permalink: "{{ route.permalink }}"
eleventyComputed:
  title: "{{ route.title }}"
  description: "{{ route.description }}"
---
<div class="wrap prose">
  <p class="eyebrow">{{ route.section }}</p>
  <h1>{{ route.title }}</h1>
  <p class="lede">{{ route.description }}</p>

  <div class="scaffold-note" role="note">
    <p><strong>Preview scaffold.</strong> This route is preserved in the local
    preview at <code>{{ route.permalink }}</code> with a correct canonical, the
    shared shell, and generated metadata. Approved copy{% if route.install %}, consented and sanitized media,{% endif %}
    and final design are owner-gated and are not part of this synthetic preview.</p>
  </div>

  <div class="actions">
    {% include "partials/contact-actions.njk" %}
    <a class="cta cta-quiet" href="/contact.html">Send a message</a>
  </div>
</div>
