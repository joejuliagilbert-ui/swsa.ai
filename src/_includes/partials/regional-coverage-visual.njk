<div class="regional-coverage-stage" role="img" aria-label="Camera coverage plan showing driveway, front entry, and backyard views">
  <span class="regional-stage-label">Three-view coverage plan</span>
  <div class="regional-property" aria-hidden="true">
    <span class="regional-roof"></span>
    <span class="regional-door"></span>
    <span class="regional-drive"></span>
  </div>
  <span class="regional-camera camera-a" aria-hidden="true"></span>
  <span class="regional-camera camera-b" aria-hidden="true"></span>
  <span class="regional-camera camera-c" aria-hidden="true"></span>
  <span class="regional-cone cone-a" aria-hidden="true"></span>
  <span class="regional-cone cone-b" aria-hidden="true"></span>
  <span class="regional-cone cone-c" aria-hidden="true"></span>
  <span class="regional-point point-a">Driveway</span>
  <span class="regional-point point-b">Front entry</span>
  <span class="regional-point point-c">Backyard</span>
  <p>{{ coverage_city }} · cameras planned around useful views</p>
</div>
