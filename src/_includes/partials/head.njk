<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.brand }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="{{ robots or 'index, follow' }}">
<link rel="canonical" href="{{ site.origin }}{{ page.url }}">

{# Self-hosted fonts only — no third-party font origins #}
<link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">

{# Social metadata #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.brand }}">
<meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.brand }}{% endif %}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.origin }}{{ page.url }}">
<meta name="twitter:card" content="summary">

{# One stable business entity, referenced by @id across the site #}
<script type="application/ld+json">
{{ site.jsonld | dump | safe }}
</script>
